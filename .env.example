# Application Configuration
APP_NAME="AI-Powered Website Link Analysis API"
APP_VERSION="1.0.0"
ENVIRONMENT="development"
HOST="0.0.0.0"
PORT=4000

# LLM Provider Configuration: 'gemini', 'openai', or 'mock' (mock enables offline testing without API keys)
LLM_PROVIDER="gemini"

# Google Gemini API Settings (Recommended for production: low cost, fast speed, 1M context)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"

# OpenAI API Settings (Alternative provider)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Crawler & Security Settings
REQUEST_TIMEOUT=15
MAX_CONTENT_LENGTH=25000
MAX_REDIRECTS=5
CACHE_TTL_SECONDS=3600
USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36 (DXORA-LinkAnalyzer/1.0)"
